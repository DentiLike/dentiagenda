<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/raiz" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:background="@drawable/fondo_widget" android:padding="8dp">
    <FrameLayout android:layout_width="70dp" android:layout_height="66dp">
        <ImageView android:id="@+id/avatar" android:layout_width="60dp" android:layout_height="60dp" android:layout_gravity="center" android:scaleType="fitCenter" android:src="@drawable/av_normal" android:contentDescription="Mikes Molares" />
        <TextView android:id="@+id/insignia" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|end" android:background="@drawable/insignia" android:paddingStart="7dp" android:paddingEnd="7dp" android:paddingTop="1dp" android:paddingBottom="1dp" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" android:visibility="gone" />
    </FrameLayout>
    <TextView android:id="@+id/chProx" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#124578" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" />
    <TextView android:id="@+id/chNom" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#5A6B85" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
