<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:id="@+id/texto" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#1E2B3C" android:textSize="13sp" android:maxLines="4" android:ellipsize="end" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/msgBtn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/boton_prim" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" android:visibility="gone" />
        <TextView android:id="@+id/msgCont" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:textColor="#8A97AB" android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
